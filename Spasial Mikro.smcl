{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}E:\Stata_Mikro\Publish\Persamaan Simultan\Spasial Mikro.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}24 Nov 2026, 22:25:42

{com}. do "C:\Users\user\AppData\Local\Temp\STD5d0_000000.tmp"
{txt}
{com}. ********************************************************************************
. * PROJECT : SIMULASI DATA MIKRO-MAKRO & SISTEM PERSAMAAN SIMULTAN (SEM)
. *           Eksperimen Monte Carlo Data Sintetis Individu ke Agregat Kab/Kota
. * METODE  : Weighted Collapse, 2SLS, 3SLS, IV-GMM, SUR, Quantile, & Survey-IV
. * AUTHOR  : Qorinul Huda
. ********************************************************************************
. 
. clear all
{res}{txt}
{com}. set more off
{txt}
{com}. set seed 20261124
{txt}
{com}. 
. ** =============================================================================
. ** TAHAP 1: PEMBANGKITAN DATASET MIKRO BESAR (N = 50.000 INDIVIDU, 100 KAB/KOTA)
. ** =============================================================================
.         * 1. Membuat kerangka 100 Kabupaten/Kota sintetis dengan variabel makro & instrumen
.         set obs 100
{txt}{p}
Number of observations ({bf:_N}) was 0,
now 100.
{p_end}

{com}.         gen int id_kab = 1100 + _n
{txt}
{com}.         gen byte pulau = ceil(_n / 20)
{txt}
{com}.         la def pulau 1 "Wilayah 1" 2 "Wilayah 2" 3 "Wilayah 3" 4 "Wilayah 4" 5 "Wilayah 5"
{txt}
{com}.         la val pulau pulau
{txt}
{com}.         
.         * Variabel Eksogen & Instrumen Tingkat Kabupaten/Kota:
.         * - infra_kab : Indeks Infrastruktur Daerah (instrumen sisi penawaran/upah)
.         * - rasio_sek : Rasio Ketersediaan Sekolah Daerah (instrumen pendidikan/konsumsi)
.         * - umk_riil  : Upah Minimum Kabupaten/Kota Riil (instrumen kebijakan upah)
.         gen double infra_kab    = rnormal(50, 15) + 5*(pulau==2)
{txt}
{com}.         gen double rasio_sek    = rnormal(65, 12) + 4*(pulau==2)
{txt}
{com}.         gen double umk_riil     = 2.2 + 0.02*infra_kab + rnormal(0, 0.3)
{txt}
{com}.         
.         * Heterogenitas tak teramati (unobserved heterogeneity) tingkat kabupaten/kota
.         gen double u_kab_earn   = rnormal(0, 0.25)
{txt}
{com}.         gen double u_kab_educ   = rnormal(0, 0.40)
{txt}
{com}.         
.         * 2. Ekspansi menjadi 500 observasi individu per kabupaten/kota (Total N = 50.000)
.         expand 500
{txt}(49,900 observations created)

{com}.         bysort id_kab: gen long id_ind = _n
{txt}
{com}.         order id_kab id_ind pulau
{txt}
{com}.         
.         * Penimbang survei (final_weight): merepresentasikan jumlah populasi per responden
.         gen double final_weight = runiform(80, 450)
{txt}
{com}.         
.         * Karakteristik Demografi Individu
.         gen byte female   = (runiform() < 0.49)
{txt}
{com}.         gen int age       = floor(runiform(18, 65))
{txt}
{com}.         gen double exp    = max(0, age - 15)
{txt}
{com}.         gen double exp_sq = exp^2
{txt}
{com}.         
.         * Kemampuan bawaan tak teramati (unobserved ability) yang memicu bias endogenitas
.         * karena berkorelasi dengan lama sekolah (educ_yr) sekaligus upah (ln_wage)
.         gen double ability = rnormal(0, 1)
{txt}
{com}.         
.         * 3. Data Generating Process (DGP) Level Individu
.         * Lama sekolah individu dipengaruhi instrumen daerah (rasio_sek), demografi, & ability
.         gen double educ_yr = 7.5 + 0.06*rasio_sek - 0.35*female - 0.03*(age-35) + 1.2*ability + u_kab_educ + rnormal(0, 1.8)
{txt}
{com}.         replace educ_yr = round(max(0, min(20, educ_yr)), 1)
{txt}(50,000 real changes made)

{com}.         
.         * Log Upah Individu (Mincer Earnings Function + Infrastruktur Daerah + Ability)
.         gen double ln_wage = 0.45 + 0.085*educ_yr + 0.032*exp - 0.0005*exp_sq - 0.18*female + 0.012*infra_kab + 0.25*ability + u_kab_earn + rnormal(0, 0.35)
{txt}
{com}.         
.         * Status Pekerja Formal (Variabel Biner 0/1 untuk model non-linear Probit/Logit)
.         gen double latent_formal = -2.2 + 0.18*educ_yr + 0.015*infra_kab - 0.25*female + 0.30*ability + rnormal(0, 1)
{txt}
{com}.         gen byte formal = (latent_formal > 0)
{txt}
{com}.         
.         * Log Pengeluaran Konsumsi Per Kapita Individu
.         gen double ln_cons = 0.30 + 0.72*ln_wage + 0.015*educ_yr - 0.004*age + rnormal(0, 0.22)
{txt}
{com}.         
.         * Hapus variabel laten tak teramati agar menyerupai struktur data survei
.         drop latent_formal ability u_kab_earn u_kab_educ
{txt}
{com}.         
.         * Pelabelan Variabel Dataset Mikro Sintetis
.         la var id_kab       "Kode Kabupaten/Kota (Sintetis)"
{txt}
{com}.         la var id_ind       "ID Unik Individu"
{txt}
{com}.         la var final_weight "Penimbang Survei (Survey Weight)"
{txt}
{com}.         la var female       "Perempuan (1=Ya, 0=Tidak)"
{txt}
{com}.         la var age          "Usia Individu (Tahun)"
{txt}
{com}.         la var educ_yr      "Lama Sekolah Individu (Tahun)"
{txt}
{com}.         la var ln_wage      "Log Pendapatan/Upah Bulanan"
{txt}
{com}.         la var ln_cons      "Log Konsumsi Per Kapita"
{txt}
{com}.         la var formal       "Status Pekerja Formal (1=Formal, 0=Informal)"
{txt}
{com}.         la var infra_kab    "Indeks Infrastruktur Kabupaten/Kota (Instrumen Z1)"
{txt}
{com}.         la var rasio_sek    "Rasio Ketersediaan Sekolah Daerah (Instrumen Z2)"
{txt}
{com}.         la var umk_riil     "Upah Minimum Kabupaten Riil (Instrumen Z3)"
{txt}
{com}.         
.         compress
  {txt}variable {bf}{res}id_ind{sf}{txt} was {bf}{res}long{sf}{txt} now {bf}{res}int{sf}
  {txt}variable {bf}{res}age{sf}{txt} was {bf}{res}int{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}exp{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
  {txt}variable {bf}{res}exp_sq{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}int{sf}
  {txt}variable {bf}{res}educ_yr{sf}{txt} was {bf}{res}double{sf}{txt} now {bf}{res}byte{sf}
{txt}  (1,150,000 bytes saved)

{com}.         save "data_mikro_simulasi_50k.dta", replace
{txt}{p 0 4 2}
file {bf}
data_mikro_simulasi_50k.dta{rm}
saved
{p_end}

{com}.         describe

{txt}Contains data from {res}data_mikro_simulasi_50k.dta
{txt} Observations:{res}        50,000                  
{txt}    Variables:{res}            15                  24 Nov 2026 22:25
