{p 0 48}{bind:rasio_sek      }{txt}{bind: double  }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}Rasio Ketersediaan Sekolah Daerah (Instrumen Z2){p_end}
{p 0 48}{bind:umk_riil       }{txt}{bind: double  }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}Upah Minimum Kabupaten Riil (Instrumen Z3){p_end}
{p 0 48}{bind:final_weight   }{txt}{bind: double  }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}Penimbang Survei (Survey Weight){p_end}
{p 0 48}{bind:female         }{txt}{bind: byte    }{bind:{txt}%8.0g     }{space 1}{bind:         }{bind:  }{res}{res}Perempuan (1=Ya, 0=Tidak){p_end}
{p 0 48}{bind:age            }{txt}{bind: byte    }{bind:{txt}%8.0g     }{space 1}{bind:         }{bind:  }{res}{res}Usia Individu (Tahun){p_end}
{p 0 48}{bind:exp            }{txt}{bind: byte    }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}{p_end}
{p 0 48}{bind:exp_sq         }{txt}{bind: int     }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}{p_end}
{p 0 48}{bind:educ_yr        }{txt}{bind: byte    }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}Lama Sekolah Individu (Tahun){p_end}
{p 0 48}{bind:ln_wage        }{txt}{bind: double  }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}Log Pendapatan/Upah Bulanan{p_end}
{p 0 48}{bind:formal         }{txt}{bind: byte    }{bind:{txt}%8.0g     }{space 1}{bind:         }{bind:  }{res}{res}Status Pekerja Formal (1=Formal, 0=Informal){p_end}
{p 0 48}{bind:ln_cons        }{txt}{bind: double  }{bind:{txt}%10.0g    }{space 1}{bind:         }{bind:  }{res}{res}Log Konsumsi Per Kapita{p_end}
{txt}{hline}
Sorted by: {res}id_kab
{txt}
{com}. 
. 
. ** =============================================================================
. ** TAHAP 2: AGREGASI TINGKAT KABUPATEN/KOTA (WEIGHTED COLLAPSE & INFERENSI)
. ** =============================================================================
.         use "data_mikro_simulasi_50k.dta", clear
{txt}
{com}.         
.         * CATATAN METODOLOGIS (WEIGHTED AGGREGATION):
.         * Untuk menghasilkan indikator makro kabupaten/kota yang representatif terhadap
.         * populasi, proses collapse menggunakan penimbang survei [aw = final_weight].
.         * Total penimbang (est_populasi) disimpan sebagai bobot inferensi pada tahap makro.
.         
.         preserve
{txt}
{com}.                 collapse (count) n_sampel = id_ind (sum) est_populasi = final_weight, by(id_kab)
{res}{txt}
{com}.                 tempfile pop_kab
{txt}
{com}.                 save `pop_kab'
{txt}{p 0 4 2}
file {bf}
C:\Users\user\AppData\Local\Temp\ST_5d0_000002.tmp{rm}
saved
as .dta format
{p_end}

{com}.         restore
{txt}
{com}.         
.         collapse (mean) avg_wage = ln_wage avg_cons = ln_cons rls_kab = educ_yr share_formal = formal share_female = female avg_age = age (first) pulau infra_kab rasio_sek umk_riil [aw = final_weight], by(id_kab)
{res}{txt}
{com}.                          
.         merge 1:1 id_kab using `pop_kab', nogen
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}               0
{txt}{col 5}Matched{col 30}{res}             100{txt}  
{col 5}{hline 41}

{com}.         
.         * Simulasi Umpan Balik Simultan (Two-Way Causality / Simultaneity Feedback):
.         * Di tingkat regional, kenaikan konsumsi agregat (avg_cons) mendorong permintaan
.         * lokal & menaikkan upah (avg_wage), sementara kenaikan upah (avg_wage) meningkatkan
.         * daya beli dan konsumsi (avg_cons). Ini menciptakan bias simultanitas pada OLS.
.         gen double shock_macro = rnormal(0, 0.08)
{txt}
{com}.         replace avg_wage = avg_wage + 0.35*avg_cons + shock_macro
{txt}(100 real changes made)

{com}.         replace avg_cons = avg_cons + 0.45*avg_wage - 0.5*shock_macro
{txt}(100 real changes made)

{com}.         
.         * Konversi proporsi ke satuan persentase (0 - 100%)
.         replace share_formal = share_formal * 100
{txt}(100 real changes made)

{com}.         replace share_female = share_female * 100
{txt}(100 real changes made)

{com}.         
.         la var est_populasi "Estimasi Total Populasi Kab/Kota (Bobot Inferensi Makro)"
{txt}
{com}.         la var avg_wage     "Rata-rata Log Upah Kab/Kota (Endogen Y1)"
{txt}
{com}.         la var avg_cons     "Rata-rata Log Konsumsi Kab/Kota (Endogen Y2)"
{txt}
{com}.         la var rls_kab      "Rata-rata Lama Sekolah Kab/Kota (Tahun)"
{txt}
{com}.         la var share_formal "Pangsa Pekerja Formal Kab/Kota (%)"
{txt}
{com}.         la var infra_kab    "Indeks Infrastruktur Kab/Kota (Instrumen Z1)"
{txt}
{com}.         la var rasio_sek    "Rasio Ketersediaan Sekolah Kab/Kota (Instrumen Z2)"
{txt}
{com}.         la var umk_riil     "UMK Riil Kab/Kota (Instrumen Z3)"
{txt}
{com}.         
.         order id_kab pulau n_sampel est_populasi avg_wage avg_cons rls_kab share_formal infra_kab rasio_sek umk_riil
{txt}
{com}.         save "data_agregat_simulasi_kabkota.dta", replace
{txt}{p 0 4 2}
file {bf}
data_agregat_simulasi_kabkota.dta{rm}
saved
{p_end}

{com}.         
.         * Statistik deskriptif tertimbang populasi antar-kabupaten/kota
.         summarize avg_wage avg_cons rls_kab share_formal infra_kab rasio_sek umk_riil [aw = est_populasi]

