    name         type    format    label      Variable label
{hline}
{p 0 48}{res}{bind:id_kab         }{txt}{bind: int     }{bind:{txt}%8.0g     }{space 1}{bind:         }{bind:  }{res}{res}Kode Kabupaten/Kota (Sintetis){p_end}
{p 0 48}{bind:id_ind         }{txt}{bind: int     }{bind:{txt}%12.0g    }{space 1}{bind:         }{bind:  }{res}{res}ID Unik Individu{p_end}
